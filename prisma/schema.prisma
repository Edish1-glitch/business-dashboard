generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  accountantEmail String?  // saved recipient for sending invoices (רו"ח)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses    Expense[]
  invoices    Invoice[]
  creditCards CreditCard[]
  emailAccounts EmailAccount[]
  invoiceSends InvoiceSend[]
  pushSubscriptions PushSubscription[]
  notifications Notification[]
  sessions    Session[]
}

model Session {
  id         String   @id @default(cuid())
  jti        String   @unique // stable id minted per login, carried in the JWT (token.sid)
  userAgent  String?
  ip         String?
  lastSeenAt DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("new-invoice") // "new-invoice", ...
  title     String
  body      String
  invoiceId String?
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  color    String?
  expenses Expense[]
  invoices Invoice[]
}

model CreditCard {
  id       String    @id @default(cuid())
  name     String
  lastFour String
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  expenses Expense[]

  @@index([userId])
}

model Expense {
  id           String      @id @default(cuid())
  amount       Float
  description  String
  date         DateTime
  source       String      // "email", "pdf", "manual", "green-invoice"
  paymentMethod String?    // "credit-card", "paypal", "cash", "transfer"
  isBusiness   Boolean     @default(true) // true = business/deductible, false = private
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([categoryId])
  @@index([date])
}

model Invoice {
  id              String    @id @default(cuid())
  fileName        String
  filePath        String
  fileUrl         String?
  fileData        String?   @db.Text // base64 encoded file content
  fileHash        String?   // SHA-256 hash for duplicate detection
  vendor          String?
  amount          Float?
  currency        String?   @default("ILS") // ILS, USD, EUR, GBP
  date            DateTime?
  source          String    // "email", "pdf-upload", "green-invoice"
  status          String    @default("pending") // "pending", "approved", "rejected"
  isBusiness      Boolean   @default(true) // true = business/deductible, false = private
  creditCardLast4 String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  emailAccountId  String?
  emailAccount    EmailAccount? @relation(fields: [emailAccountId], references: [id])
  expenses        Expense[]
  sends           InvoiceSend[]
  createdAt       DateTime      @default(now())

  @@index([userId])
  @@index([source])
  @@index([status])
  @@index([emailAccountId])
}

model InvoiceSend {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentTo    String   // recipient email (usually the accountant)
  subject   String?
  fromEmail String?  // which connected Gmail account sent it
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model EmailAccount {
  id           String   @id @default(cuid())
  email        String
  provider     String   @default("gmail")
  accessToken  String?
  refreshToken String?
  scopes       String?  // OAuth scopes granted (space-separated); used to detect gmail.send permission
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  tokenExpiresAt DateTime?
  lastSyncAt   DateTime?
  syncRanges   SyncRange[]
  invoices     Invoice[]
  createdAt    DateTime @default(now())

  @@unique([email, userId])
  @@index([userId])
}

model SyncRange {
  id             String       @id @default(cuid())
  fromDate       DateTime
  toDate         DateTime
  invoicesFound  Int          @default(0)
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([emailAccountId])
}
