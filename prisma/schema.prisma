generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  accountantEmail String?  // saved recipient for sending invoices (רו"ח)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  expenses    Expense[]
  invoices    Invoice[]
  creditCards CreditCard[]
  emailAccounts EmailAccount[]
  invoiceSends InvoiceSend[]
  pushSubscriptions PushSubscription[]
  notifications Notification[]
  sessions    Session[]
}

model Session {
  id         String   @id @default(cuid())
  jti        String   @unique // stable id minted per login, carried in the JWT (token.sid)
  userAgent  String?
  ip         String?
  revoked    Boolean  @default(false) // explicit "disconnect device" — only this blocks auth
  lastSeenAt DateTime @default(now())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  createdAt  DateTime @default(now())

  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  type      String   @default("new-invoice") // "new-invoice", ...
  title     String
  body      String
  invoiceId String?
  read      Boolean  @default(false)
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId, read])
  @@index([userId, createdAt])
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([userId])
}

model Category {
  id       String    @id @default(cuid())
  name     String    @unique
  icon     String?
  color    String?
  expenses Expense[]
  invoices Invoice[]
}

model CreditCard {
  id       String    @id @default(cuid())
  name     String
  lastFour String
  userId   String
  user     User      @relation(fields: [userId], references: [id])
  expenses Expense[]

  @@index([userId])
}

model Expense {
  id           String      @id @default(cuid())
  amount       Float
  description  String
  date         DateTime
  source       String      // "email", "pdf", "manual", "green-invoice"
  paymentMethod String?    // "credit-card", "paypal", "cash", "transfer"
  isBusiness   Boolean     @default(true) // true = business/deductible, false = private
  categoryId   String?
  category     Category?   @relation(fields: [categoryId], references: [id])
  creditCardId String?
  creditCard   CreditCard? @relation(fields: [creditCardId], references: [id])
  invoiceId    String?
  invoice      Invoice?    @relation(fields: [invoiceId], references: [id])
  userId       String
  user         User        @relation(fields: [userId], references: [id])
  createdAt    DateTime    @default(now())

  @@index([userId])
  @@index([categoryId])
  @@index([date])
}

model Invoice {
  id              String    @id @default(cuid())
  fileName        String
  filePath        String
  fileUrl         String?
  fileData        String?   @db.Text // base64 encoded file content
  fileHash        String?   // SHA-256 hash for duplicate detection
  vendor          String?
  amount          Float?
  currency        String?   @default("ILS") // ILS, USD, EUR, GBP
  date            DateTime?
  source          String    // "email", "pdf-upload", "green-invoice"
  status          String    @default("pending") // "pending", "approved", "rejected"
  isBusiness      Boolean   @default(true) // true = business/deductible, false = private
  creditCardLast4 String?
  categoryId      String?
  category        Category? @relation(fields: [categoryId], references: [id])
  userId          String
  user            User          @relation(fields: [userId], references: [id])
  emailAccountId  String?
  emailAccount    EmailAccount? @relation(fields: [emailAccountId], references: [id])
  expenses        Expense[]
  sends           InvoiceSend[]
  createdAt       DateTime      @default(now())
  deletedAt       DateTime?     // soft delete → "נמחקו לאחרונה"; purged for good after 14 days

  @@index([userId])
  @@index([source])
  @@index([status])
  @@index([emailAccountId])
  @@index([deletedAt])
}

model InvoiceSend {
  id        String   @id @default(cuid())
  invoiceId String
  invoice   Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  sentTo    String   // recipient email (usually the accountant)
  subject   String?
  fromEmail String?  // which connected Gmail account sent it
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())

  @@index([invoiceId])
  @@index([userId])
}

model EmailAccount {
  id           String   @id @default(cuid())
  email        String
  provider     String   @default("gmail")
  accessToken  String?
  refreshToken String?
  scopes       String?  // OAuth scopes granted (space-separated); used to detect gmail.send permission
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  tokenExpiresAt DateTime?
  needsReconnect Boolean  @default(false) // set when Google rejects the token (invalid_grant); cleared on successful refresh/reconnect
  lastError    String?   // last token/sync error message (for the mailbox health view); cleared on successful refresh
  lastErrorAt  DateTime? // when lastError was recorded
  lastSyncAt   DateTime?
  syncRanges   SyncRange[]
  invoices     Invoice[]
  createdAt    DateTime @default(now())

  @@unique([email, userId])
  @@index([userId])
}

model SyncRange {
  id             String       @id @default(cuid())
  fromDate       DateTime
  toDate         DateTime
  invoicesFound  Int          @default(0)
  emailAccountId String
  emailAccount   EmailAccount @relation(fields: [emailAccountId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([emailAccountId])
}

// ── MCP (Model Context Protocol) remote server: OAuth + audit ────────────────
// Lets the claude.ai personal assistant connect to FinDash as a custom
// connector. All additive; nothing here touches the existing app.

// An OAuth client registered via Dynamic Client Registration (RFC 7591), e.g.
// claude.ai. Public client (no secret) — security comes from PKCE.
model McpClient {
  id           String     @id @default(cuid()) // the OAuth client_id
  name         String // client_name from registration
  redirectUris String[] // allowed redirect URIs
  createdAt    DateTime   @default(now())
  tokens       McpToken[]
}

// Short-lived authorization code (PKCE authorization-code flow). Hashed at rest.
model McpAuthCode {
  id            String   @id @default(cuid())
  codeHash      String   @unique // sha256 of the issued code
  clientId      String
  userId        String // the FinDash user who approved
  redirectUri   String
  codeChallenge String // PKCE S256 challenge
  scope         String?
  resource      String? // RFC 8707 resource indicator
  expiresAt     DateTime
  createdAt     DateTime @default(now())

  @@index([expiresAt])
}

// An issued access/refresh token pair (opaque, hashed at rest). One row per
// active connector grant; revoking it disconnects that connector.
model McpToken {
  id               String    @id @default(cuid())
  accessTokenHash  String    @unique
  refreshTokenHash String?   @unique
  clientId         String
  client           McpClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId           String
  scope            String?
  resource         String?
  label            String? // connector name, for the settings list
  accessExpiresAt  DateTime
  refreshExpiresAt DateTime?
  revoked          Boolean   @default(false)
  lastUsedAt       DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([clientId])
}

// Audit log: one row per MCP tool call (time, tool, param summary, outcome).
model McpActionLog {
  id        String   @id @default(cuid())
  userId    String
  tool      String
  summary   String // short, non-sensitive parameter summary
  ok        Boolean
  result    String? // short result or error summary
  clientId  String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}
